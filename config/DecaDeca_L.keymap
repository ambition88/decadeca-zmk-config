#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 4 ESC  &kp Q     &kp W     &kp E        &kp R  &kp T
&lt 2 TAB  &kp A     &kp S     &kp D        &kp F  &kp G
&kp LSHFT  &kp Z     &kp X     &kp C        &kp V  &kp B
&kp LCTRL  &kp LGUI  &kp LALT  &lt 1 SPACE
            >;
        };

        layer_1 {
            bindings = <
&none        &kp N1           &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5
&kp TILDE    &kp EXCLAMATION  &kp AT_SIGN   &kp POUND     &kp DOLLAR    &kp PERCENT
&none        &kp F1           &kp F2        &kp F3        &kp F4        &kp F5
&bootloader  &none            &none         &none
            >;
        };
    };
};
